<?xml version="1.0"?>
<!--
  NVIDIA JetBot (v3) for Gazebo Classic + RViz2.

  Frames:  base_footprint (root, on the ground under the robot)
             -> chassis                           (fixed; all body geometry lives here)
                 -> left_wheel / right_wheel     (continuous joints, axis y)
                 -> camera_link -> camera_optical_frame

  The CAD meshes in ../gazebo/models/jetbot/meshes are in millimetres and Y-up, so every mesh
  is scaled by 0.001 and rotated (roll 90deg, yaw 90deg) into Gazebo's x-forward / z-up frame.
  Physics uses primitives (box body + ball caster + wheel cylinders); the meshes are visual only.
  Dimensions below were measured from JetBot-v3-Chassis.stl and JetBot-v3-Wheel.stl.
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="jetbot">

  <xacro:property name="mesh_dir"   value="package://jetbot_ros/models/jetbot/meshes"/>
  <xacro:property name="mesh_scale" value="0.001 0.001 0.001"/>
  <xacro:property name="mesh_rpy"   value="${pi/2} 0 ${pi/2}"/>

  <xacro:property name="body_length"    value="0.137"/>
  <xacro:property name="body_width"     value="0.106"/>
  <xacro:property name="body_height"    value="0.099"/>
  <xacro:property name="body_clearance" value="0.012"/>
  <xacro:property name="body_mass"      value="1.0"/>

  <xacro:property name="wheel_radius"      value="0.030"/>
  <xacro:property name="wheel_width"       value="0.012"/>
  <xacro:property name="wheel_mass"        value="0.1"/>
  <xacro:property name="wheel_x"           value="0.03"/>
  <xacro:property name="wheel_separation"  value="0.1106"/>
  <xacro:property name="wheel_mesh_offset" value="0.004"/>

  <xacro:property name="caster_radius" value="0.0127"/>
  <xacro:property name="caster_x"      value="-0.051"/>

  <xacro:property name="camera_xyz"   value="0.055 0 0.0857"/>
  <xacro:property name="camera_pitch" value="0.25"/>

  <material name="dark_grey">
    <color rgba="0.1 0.1 0.1 1"/>
  </material>

  <!-- ================= base ================= -->
  <!-- massless root on the ground (REP-120); KDL/robot_state_publisher needs an inertia-free root -->
  <link name="base_footprint"/>

  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="chassis"/>
  </joint>

  <!-- ================= chassis ================= -->
  <link name="chassis">
    <visual>
      <origin xyz="0 0 0.043" rpy="${mesh_rpy}"/>
      <geometry>
        <mesh filename="${mesh_dir}/JetBot-v3-Chassis.dae" scale="${mesh_scale}"/>
      </geometry>
    </visual>
    <!-- keep these collisions unnamed: sdformat only applies the <gazebo reference="chassis">
         friction below to collisions it names itself (chassis_collision, chassis_collision_1) -->
    <collision>
      <origin xyz="0 0 ${body_clearance + (body_height - body_clearance) / 2}"/>
      <geometry>
        <box size="${body_length} ${body_width} ${body_height - body_clearance}"/>
      </geometry>
    </collision>
    <collision>
      <origin xyz="${caster_x} 0 ${caster_radius}"/>
      <geometry>
        <sphere radius="${caster_radius}"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0.05"/>
      <mass value="${body_mass}"/>
      <inertia ixx="${body_mass * (body_width**2 + body_height**2) / 12}" ixy="0" ixz="0"
               iyy="${body_mass * (body_length**2 + body_height**2) / 12}" iyz="0"
               izz="${body_mass * (body_length**2 + body_width**2) / 12}"/>
    </inertial>
  </link>

  <!-- the caster is the only part of the chassis that touches the ground; let it slide -->
  <gazebo reference="chassis">
    <mu1>0.0</mu1>
    <mu2>0.0</mu2>
  </gazebo>

  <!-- ================= wheels ================= -->
  <!-- Joint origins sit exactly at the tyre centres (+/- wheel_separation/2) with the collision and
       inertia centred on the joint. Keep it that way: the wheel STL starts at x=0 and is 8 mm thick,
       so only the visual carries the 4 mm offset. Putting that offset on the collision/inertia instead
       (as the original SDF's asymmetric link poses did) makes ODE yaw the robot when driving straight. -->
  <xacro:macro name="wheel" params="prefix side">
    <link name="${prefix}_wheel">
      <visual>
        <origin xyz="0 ${-wheel_mesh_offset} 0" rpy="0 0 ${pi/2}"/>
        <geometry>
          <mesh filename="${mesh_dir}/JetBot-v3-Wheel.stl" scale="${mesh_scale}"/>
        </geometry>
        <material name="dark_grey"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
        </geometry>
      </collision>
      <inertial>
        <mass value="${wheel_mass}"/>
        <inertia ixx="${wheel_mass * (3 * wheel_radius**2 + wheel_width**2) / 12}" ixy="0" ixz="0"
                 iyy="${wheel_mass * wheel_radius**2 / 2}" iyz="0"
                 izz="${wheel_mass * (3 * wheel_radius**2 + wheel_width**2) / 12}"/>
      </inertial>
    </link>

    <joint name="${prefix}_wheel_hinge" type="continuous">
      <parent link="chassis"/>
      <child link="${prefix}_wheel"/>
      <origin xyz="${wheel_x} ${side * wheel_separation / 2} ${wheel_radius}"/>
      <axis xyz="0 1 0"/>
    </joint>

    <gazebo reference="${prefix}_wheel">
      <mu1>1.0</mu1>
      <mu2>1.0</mu2>
      <material>Gazebo/DarkGrey</material>
    </gazebo>
  </xacro:macro>

  <xacro:wheel prefix="left"  side="1"/>
  <xacro:wheel prefix="right" side="-1"/>

  <!-- ================= camera ================= -->
  <link name="camera_link">
    <inertial>
      <mass value="0.01"/>
      <inertia ixx="1e-6" ixy="0" ixz="0" iyy="1e-6" iyz="0" izz="1e-6"/>
    </inertial>
  </link>

  <joint name="camera_joint" type="fixed">
    <parent link="chassis"/>
    <child link="camera_link"/>
    <origin xyz="${camera_xyz}" rpy="0 ${camera_pitch} 0"/>
  </joint>

  <!-- ROS optical convention: z forward, x right, y down -->
  <link name="camera_optical_frame"/>

  <joint name="camera_optical_joint" type="fixed">
    <parent link="camera_link"/>
    <child link="camera_optical_frame"/>
    <origin xyz="0 0 0" rpy="${-pi/2} 0 ${-pi/2}"/>
  </joint>

  <gazebo reference="camera_link">
    <sensor name="camera" type="camera">
      <always_on>true</always_on>
      <update_rate>10</update_rate>
      <visualize>true</visualize>
      <camera>
        <horizontal_fov>2.0</horizontal_fov>
        <image>
          <width>320</width>
          <height>240</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.01</near>
          <far>20</far>
        </clip>
      </camera>
      <plugin name="camera_controller" filename="libgazebo_ros_camera.so">
        <ros>
          <namespace>/jetbot</namespace>
        </ros>
        <camera_name>camera</camera_name>
        <frame_name>camera_optical_frame</frame_name>
      </plugin>
    </sensor>
  </gazebo>

  <!-- ================= ROS 2 plugins ================= -->
  <gazebo>
    <plugin name="diff_drive" filename="libgazebo_ros_diff_drive.so">
      <ros>
        <namespace>/jetbot</namespace>
      </ros>
      <update_rate>50</update_rate>

      <left_joint>left_wheel_hinge</left_joint>
      <right_joint>right_wheel_hinge</right_joint>
      <wheel_separation>${wheel_separation}</wheel_separation>
      <wheel_diameter>${2 * wheel_radius}</wheel_diameter>

      <max_wheel_torque>1.0</max_wheel_torque>
      <max_wheel_acceleration>3.0</max_wheel_acceleration>

      <publish_odom>true</publish_odom>
      <publish_odom_tf>true</publish_odom_tf>
      <!-- wheel TFs come from robot_state_publisher via /joint_states instead -->
      <publish_wheel_tf>false</publish_wheel_tf>

      <odometry_frame>odom</odometry_frame>
      <robot_base_frame>base_footprint</robot_base_frame>
    </plugin>

    <plugin name="joint_states" filename="libgazebo_ros_joint_state_publisher.so">
      <ros>
        <namespace>/jetbot</namespace>
      </ros>
      <update_rate>50</update_rate>
      <joint_name>left_wheel_hinge</joint_name>
      <joint_name>right_wheel_hinge</joint_name>
    </plugin>
  </gazebo>

</robot>
